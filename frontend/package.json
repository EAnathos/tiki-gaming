{
  "name": "tiki-gaming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "typecheck": "tsc -b",
    "db:types": "supabase gen types typescript --project-id scuqcjtuohcaqyjaytul --schema public > src/lib/database.types.ts",
    "db:sql": "node scripts/db.mjs",
    "db:migrate": "node scripts/db.mjs --migrate",
    "db:check": "node scripts/check-migrations.mjs",
    "rtm:check": "node scripts/check-rtm.mjs",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:bang": "playwright test --config playwright.bang-real.config.ts",
    "quality:seed": "node scripts/seed-quality.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@stomp/stompjs": "^7.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "cannon-es": "^0.20.0",
    "pino": "^10.4.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sockjs-client": "^1.6.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "prettier": "3.9.10",
    "supabase": "^3.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
