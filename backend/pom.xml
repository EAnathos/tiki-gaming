<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>fr.tikigaming</groupId>
  <artifactId>tiki-gaming-backend</artifactId>
  <version>0.1.0</version>
  <name>Tiki Gaming Backend</name>

  <properties>
    <java.version>21</java.version>
    <spotless.version>3.10.4</spotless.version>
    <palantir-java-format.version>2.103.0</palantir-java-format.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>14.4.0</checkstyle.version>
    <jacoco.version>0.8.16</jacoco.version>
    <pitest.version>1.30.1</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <pitest-history.version>0.0.1</pitest-history.version>
    <!-- Ligne 3.x = Spring Boot 4.x (la 2.x de springdoc cible Spring Boot 3). -->
    <springdoc.version>3.2.0</springdoc.version>
    <pact.version>4.7.7</pact.version>
    <!-- Ligne 8.x = moteur JUnit 6 (la 7.x cible JUnit 5). -->
    <cucumber.version>8.0.4</cucumber.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <!-- RestClient.Builder pour appeler Supabase (module séparé depuis Spring Boot 4). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Validation des requêtes (Bean Validation / Hibernate Validator) : l'équivalent de Zod côté front. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Socle temps réel (fr.tikigaming.realtime) : STOMP sur WebSocket, SockJS en repli. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Contrat Pact : le backend rejoue le contrat écrit par le front (frontend/pacts, PactProviderTest). -->
    <dependency>
      <groupId>au.com.dius.pact.provider</groupId>
      <artifactId>junit5</artifactId>
      <version>${pact.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Chaos : Toxiproxy (latence, coupure réseau) entre le backend et un faux Supabase, dans Docker.
         Versions gérées par Spring Boot (Testcontainers 2.x). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-toxiproxy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Depuis Spring Boot 4, @AutoConfigureMockMvc est dans son propre module de test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests d'intégration contre une vraie base et un vrai PostgREST (classes *IT : ignorées par `mvn test`,
         lancées par le job CI « Integration (Testcontainers) »). Version gérée par Spring Boot. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- BDD : scénarios Gherkin (.feature) exécutés par JUnit, donc par mvn verify et la CI. -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests réels de persistance Dames : accès JDBC de contrôle (Testcontainers est déclaré plus haut).
         Version gérée par le BOM Spring Boot ; aucune dépendance ajoutée au serveur livré. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <properties>
            <configurationParameters>
              cucumber.junit-platform.discovery.as-root-engine=false
            </configurationParameters>
          </properties>
        </configuration>
      </plugin>

      <!-- Couverture des tests (JaCoCo) : target/site/jacoco/jacoco.xml après `mvn verify`, lu par SonarQube. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- Seuils bloquants : le cœur de l'authentification reste couvert ; le global, juste sous l'existant,
               empêche les régressions (le relever quand la couverture monte, jamais le baisser). -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.52</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.64</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>fr.tikigaming.auth.UsernameValidator</include>
                    <include>fr.tikigaming.auth.SupabaseErrors</include>
                    <include>fr.tikigaming.auth.SupabaseTokenService</include>
                    <include>fr.tikigaming.resilience.CircuitBreaker</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatter : `mvn spotless:apply` reformate, `mvn verify` échoue si le code n'est pas formaté. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Linter : règles dans checkstyle.xml, vérifiées dès la phase validate. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Les *IT sont séparés des unitaires et de PIT. Docker obligatoire, jamais de skip automatique. -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <failIfNoTests>true</failIfNoTests>
              <systemPropertyVariables>
                <dame.repositoryRoot>${project.basedir}/..</dame.repositoryRoot>
                <ticTacToe.repositoryRoot>${project.basedir}/..</ticTacToe.repositoryRoot>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Mutation testing : `mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage`
         (rapport dans target/pit-reports). Échoue sous 75 % de mutants tués sur le cœur métier. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
              <!-- Depuis Pitest 1.23, l'analyse incrémentale (historyInputFile/historyOutputFile) est un plugin séparé. -->
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-history-plugin</artifactId>
                <version>${pitest-history.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>fr.tikigaming.auth.UsernameValidator</param>
                <param>fr.tikigaming.auth.SupabaseErrors</param>
                <param>fr.tikigaming.auth.SupabaseTokenService</param>
                <param>fr.tikigaming.games.dame.*</param>
                <param>fr.tikigaming.games.mastermind.MastermindGame</param>
                <param>fr.tikigaming.games.rush_hour.*</param>
                <param>fr.tikigaming.games.prismine.Engine*</param>
                <param>fr.tikigaming.games.prismine.Expedition*</param>
                <param>fr.tikigaming.games.prismine.Floors*</param>
                <param>fr.tikigaming.games.prismine.PrismineScoreValidator</param>
                <param>fr.tikigaming.resilience.*</param>
                <param>fr.tikigaming.games.sdv_civilisation.*</param>
                <param>fr.tikigaming.games.mini_gta.progress.*</param>
                <param>fr.tikigaming.games.mini_gta.core.*</param>
                <param>fr.tikigaming.games.mini_gta.world.Navigation</param>
                <param>fr.tikigaming.games.mini_gta.world.MinHeap</param>
                <param>fr.tikigaming.games.mini_gta.world.WorldConstants</param>
              </targetClasses>
              <targetTests>
                <param>fr.tikigaming.auth.*Test</param>
                <param>fr.tikigaming.resilience.*</param>
                <param>fr.tikigaming.games.dame.*Test</param>
                <param>fr.tikigaming.games.mastermind.MastermindGameTest</param>
                <param>fr.tikigaming.games.rush_hour.*Test</param>
                <param>fr.tikigaming.games.prismine.*Test</param>
                <param>fr.tikigaming.games.sdv_civilisation.*Test</param>
                <param>fr.tikigaming.games.mini_gta.progress.*Test</param>
                <param>fr.tikigaming.games.mini_gta.core.*Test</param>
                <param>fr.tikigaming.games.mini_gta.world.*Test</param>
                <param>fr.tikigaming.games.mini_gta.api.*Test</param>
              </targetTests>
              <mutators>
                <mutator>STRONGER</mutator>
              </mutators>
              <!-- Les appels de journalisation n'ont pas d'effet observable : mutants équivalents. -->
              <avoidCallsTo>
                <avoidCallsTo>org.slf4j</avoidCallsTo>
              </avoidCallsTo>
              <mutationThreshold>75</mutationThreshold>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
